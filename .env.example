# ─── Bank reconciliation agent ────────────────────────────────────────────────
#
# Copy to .env. Nothing here is required to start the server; the two that
# matter are the port it listens on and the port your Chrome is debugging on.

# The web UI and its WebSocket.
PORT=3000

# Chrome's remote-debugging port. `npm run start:chrome` launches Chrome on
# this, and a run connects to it over CDP. SIGN INTO TRAMADA IN THAT WINDOW —
# the run waits for you and never types credentials itself.
CDP_PORT=9222
CDP_HOST=127.0.0.1

# The Tramada instance a run drives.
TRAMADA_URL=https://asp.tramada.com.au/ttms/raatravelsandbox

# Where the run history lives. The tables are created on first boot. UNSET = the
# server runs in memory only (usable, but runs are lost on restart). The uploaded
# report bytes always stay on disk in uploads/. Full setup: docs/DATABASE.md.
#
# LOCAL (default for now):
DATABASE_URL=postgres://recon:recon@localhost:5432/recon
# docker compose (DB on the host): use host.docker.internal instead of localhost.
# LIVE (later — change just this one line):
# DATABASE_URL=postgres://user:password@live-host:5432/dbname?sslmode=require

# Verbose logging.
DEBUG=false

# ─── Not used by the server ───────────────────────────────────────────────────
# `run-bookings.js` builds test bookings to reconcile against. It signs in the
# same way — by waiting for you — so these stay empty unless you have a reason.
# TRAMADA_USERNAME=
# TRAMADA_PASSWORD=

# ─── Entra sign-in (docs/azure-setup.md) ──────────────────────────────────────
# All THREE or none. With none, the app has no login and behaves as it always
# did; with some, sign-in stays off and the startup banner says so — a
# half-filled block here is the failure most likely to look like success.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Must match a Redirect URI on the app registration, exactly. http:// is legal
# only for localhost; anything else has to be https.
# AZURE_REDIRECT_URI=

# Signs the session cookie. Required once the three above are set — a
# predictable value here is a forgeable session on a finance system.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# ─── Tramada credentials in Azure Key Vault (docs/azure-setup.md §7) ──────────
# Two secrets per person, named from their email: tim@raa.com is stored as
# `tramada-tim-raa-com-username` and `tramada-tim-raa-com-password`.
# Unset, the app waits for a human to sign into Tramada on the noVNC screen —
# exactly how it worked before any of this existed.
# AZURE_KEYVAULT_URL=
