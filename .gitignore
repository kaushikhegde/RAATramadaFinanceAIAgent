csv_uploads/
*.png
uploads/

# The security audit log (RAA Logging and Monitoring Standard v1.1 §3.1.3).
# One JSON object per line, one file per day, on the RECON_STORE_DIR volume
# beside uploads/. Never committed: it is a record of who did what on a
# finance system, and a copy of it in a git history is a copy nobody is
# managing the retention of.
logs/

runs.json
runs.json.corrupt-*
.DS_Store
_to_delete/

# Distribution artifacts (image tarballs are large; do not commit)
dist/*.tar.gz
certs/SA_ROOT.crt
certs/README.md

# Mastercard signing keys — never commit these
*.p12
*.pfx
*-encryption-key.pem

# Pasted IPSI "Approved" screens — real transaction data, never commit
approved.txt
approved*.txt

# The Docker volume: runs.json, uploads/ and the Chrome profile the Tramada
# login lives in. Bind-mounted so you can read it; never committed.
data/

# Microsoft Graph sign-in for the DVC emails (refresh token — never commit)
.graph-token-cache.json
tokio-remarks.json
